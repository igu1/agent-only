# ── Backend API (the CRM backend implementing /api/agent/v1/...) ──
# Django today; any backend (e.g. ASP.NET Core) implementing the same contract works.
DJANGO_INTERNAL_URL=http://localhost:8000
AGENT_API_TOKEN=change-me

# ── LLM provider ──
# AI_MODEL: openrouter | google | groq
AI_MODEL=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=google/gemini-3.1-flash-lite-preview
# GOOGLE_API_KEY=
# GOOGLE_MODEL_ID=google/gemini-3-flash-preview
# GROQ_API_KEY=
# GROQ_MODEL_ID=meta-llama/llama-3.1-8b-instant

# ── Tenant defaults ──
# Timezone used for prompts/date context when the AI profile has no timezone field
AGENT_TIMEZONE=Asia/Riyadh

# ── RAG / knowledge (Qdrant + embeddings) ──
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# AGNO_EMBEDDER: openai | google
AGNO_EMBEDDER=openai
OPENAI_API_KEY=

# ── Realtime fan-out ──
# REALTIME_MODE: channels (Django Channels via Redis, default) | http (POST /api/agent/v1/events/ for SignalR backends)
REALTIME_MODE=channels
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Webchat (website chat widget) ──
# Comma-separated origins allowed to call the webchat endpoints from the browser.
# Empty = CORS middleware disabled (webchat only reachable same-origin / server-side).
WEBCHAT_ALLOWED_ORIGINS=http://localhost:4000

# ── Agent-side config cache ──
# REDIS_URL empty = in-process cache only
REDIS_URL=
CRONO_AGENT_CACHE_TTL=60
