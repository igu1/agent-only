# ─────────────────────────────────────────────────────────────────────────
# Agent service - SHARED stack configuration (SaaS).
#
# One deployment serves every organization. Anything that differs BETWEEN
# organizations - backend URL, API token, Gemini key, Qdrant prefix, WhatsApp
# Phone Number IDs, allowed web-chat origins - lives in tenants.json, never
# here. See tenants.example.json and SAAS-ARCHITECTURE.md.
#
# This file holds what every organization shares, plus the operator token.
# ─────────────────────────────────────────────────────────────────────────

# ── The tenant registry (this is what turns SaaS on) ──────────────────────
# REQUIRED. Points at the org registry - every organization's backend URL,
# token, Gemini key, Qdrant prefix, WhatsApp Phone Number IDs and web-chat
# origins live there, one JSON block each. Nothing about a specific customer
# belongs in this file.
#
# Onboarding is "append one org + reload" - no rebuild, no restart, no
# downtime for organizations already being served:
#   curl -X POST .../infra/reload-tenants -H "X-Agent-Token: $AGENT_API_TOKEN"
TENANTS_FILE=/app/agent/tenants.json

# ── Strict tenancy ────────────────────────────────────────────────────────
# ON: a request that cannot say which organization it belongs to is REFUSED
# (400), instead of being answered by guessing one.
#
# Leave it on for SaaS. Off, "I could not identify the organization" is
# answered by quietly picking the default one - which means a parent's inquiry
# is created in ANOTHER company's CRM, with no error and no log line, and the
# database it landed in looks entirely normal. There is no later signal.
#
# What this closes, all of which would otherwise reach the default tenant:
#   web chat     posted to /webhooks/webchat/...   without the org segment
#   WhatsApp     a phone_number_id not listed in any org's phone_number_ids
#   WhatsApp     Meta's verification GET on the non-org URL (it carries no
#                payload at all, so nothing in it can name an organization)
#   Telegram     every request - it has no org-prefixed route (unused today)
#   /rag/reindex called with THIS operator token rather than an org's own
#
# So under strict tenancy every channel must use its org-prefixed URL:
#   https://<agent-host>/webhooks/<org>/webchat/<channel_id>
#   https://<agent-host>/webhooks/<org>/whatsapp/<channel_id>/
#
# Turn it OFF only when this stack genuinely serves ONE organization and
# tenants.json is empty - there is then no other company for a request to
# land in. Any stack with a registry should keep it on.
STRICT_TENANCY=true

# ── Operator token ────────────────────────────────────────────────────────
# Guards this service's own admin endpoints (/infra/reload-tenants,
# /infra/clear-cache). An organization's own api_token also authenticates and
# additionally identifies the caller's org.
#
# LEAVE THIS SET. With no value configured the guard stays open for local
# development, which in production means anyone can reload your registry.
AGENT_API_TOKEN=change-me

# ── Listening port ────────────────────────────────────────────────────────
# ONE number for the whole stack. uvicorn listens on it inside the container,
# compose publishes the SAME number on the host, the image HEALTHCHECK probes
# it, and onboard-org.sh reads it for its reload call and its printed
# AgentBaseUrl. So http://localhost:<AGENT_PORT> is the agent from anywhere
# on this server. If you pick another number, also change the literal 5021
# in nginx-org.conf.template (and deploy/k8s/*.yaml if you use Kubernetes).
AGENT_PORT=5021

# ── LLM provider ──────────────────────────────────────────────────────────
# AI_MODEL: openrouter | google | groq
AI_MODEL=openrouter
OPENROUTER_API_KEY=                                # read by the SDK
OPENROUTER_MODEL_ID=google/gemini-3.1-flash-lite-preview
# GOOGLE_MODEL_ID=gemini-3-flash-preview
# GOOGLE_THINKING_LEVEL=low   # optional: low = faster replies; unset = model default
# GROQ_API_KEY=
# GROQ_MODEL_ID=meta-llama/llama-3.1-8b-instant
#
# GOOGLE_API_KEY is per-organization (tenants.json -> google_api_key) so each
# customer carries its own quota and billing. Set one here only as the
# fallback for orgs that do not define their own.
# GOOGLE_API_KEY=

# ── Knowledge base (Qdrant + embeddings) ──────────────────────────────────
# One Qdrant serves every organization; collections are named
# <qdrant_prefix>-<agent_id>, and the prefix is per-org in tenants.json, so
# one school's documents can never be searched from another's chat.
#
# WITHOUT QDRANT_URL the agent runs on its lookup tools alone: no knowledge
# base is attached and search_knowledge_base is NOT advertised to the model
# (a startup warning says so, rather than the model inventing answers).
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# QDRANT_SEARCH=hybrid                             # needs the fastembed sparse model
# AGNO_EMBEDDER: openai | google
AGNO_EMBEDDER=openai
OPENAI_API_KEY=                                    # read by the SDK

# ── Chat memory (mem/db.sqlite3) ──────────────────────────────────────────
# A CACHE of the model's working memory - every message is already in
# CmpAgentMessage and every inquiry in CmpRegistration on the org's own SQL
# Server, so this file needs no backup. Sessions untouched for this many days
# are swept at startup and the file is compacted once a quarter of it is free.
# 0 disables the sweep. Raise it for longer chat memory; the cost is disk and
# how long parents' contact details sit in an unencrypted file.
SESSION_RETENTION_DAYS=7

# ── Defaults ──────────────────────────────────────────────────────────────
# Used for prompts/date context when an AI profile carries no timezone.
AGENT_TIMEZONE=Asia/Riyadh

# ── Realtime fan-out ──────────────────────────────────────────────────────
# How the agent pushes live updates (new message, typing) to the CRM screen.
#
# http  = POST /api/agent/v1/events/, which the .NET backend fans out over
#         SignalR. THIS IS WHAT ONLINECAMPUS USES. Needs no Redis.
# channels = push into a Django Channels Redis layer (a different backend;
#         the code's historical default, which is why it must be set here).
#
# Left unset it defaults to "channels", and the CRM's live updates simply
# stop arriving - no error on either side, the screen just goes quiet.
REALTIME_MODE=http

# ── Agent-side config cache ───────────────────────────────────────────────
# REDIS_URL empty = in-process cache only. Set it once more than one agent
# replica runs, so they share one view of each org's CRM configuration.
REDIS_URL=
CRONO_AGENT_CACHE_TTL=60

# ── Channel API bases (override only for tests) ───────────────────────────
# Point WhatsApp at tests/fake_meta.py to capture sends instead of delivering
# them. Leave UNSET in production so the real Cloud API is used.
# WHATSAPP_API_BASE=http://127.0.0.1:9001
# TELEGRAM_API_BASE=
# INSTAGRAM_API_BASE=

# ── Scale add-on: gateway + queue + workers (SAAS-ARCHITECTURE.md phase 3) ─
# Opt-in. Without QUEUE_MODE the agent runs single-service exactly as before.
# QUEUE_MODE=redis
# QUEUE_DEBOUNCE_SECONDS=2                         # merge a burst into one turn
# TENANT_MAX_CONCURRENT=4                          # per-org fairness cap
# WORKER_CONCURRENCY=2                             # turns per worker process

# ── Web-chat browser origins ──────────────────────────────────────────────
# NOT set here. Each organization lists its own website origins in
# tenants.json (webchat_origins); the agent builds its CORS allow-list from
# the live registry, so onboarding a new school needs no restart.
#
# An origin missing there is the one failure that looks like nothing: the
# widget loads, the request leaves the browser, and the reply is discarded by
# CORS with no server-side error at all.
